@model PasswordManager.Models.PasswordEntry

<div class="container mt-4">
    <h2>Details for @Model.Site</h2>
    <dl class="row">
        <dt class="col-sm-3">Site</dt>
        <dd class="col-sm-9">@Model.Site</dd>

        <dt class="col-sm-3">Password For</dt>
        <dd class="col-sm-9">@Model.PasswordFor</dd>

        <dt class="col-sm-3">Email Address</dt>
        <dd class="col-sm-9">@ViewBag.MaskedEmail</dd>

        <dt class="col-sm-3">Password</dt>
        <dd class="col-sm-9">@ViewBag.MaskedPassword</dd>
    </dl>

    <button class="btn btn-warning" id="revealPasswordBtn">See Password</button>

    <div id="passwordModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document"> 
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Verify Email</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Please enter the email associated with this entry to view the password.</p>
                    <input type="email" class="form-control" id="emailInput" placeholder="Enter email address" required>
                    <div id="passwordReveal" class="mt-3 text-wrap" style="word-break: break-word;"></div> 

                    <button type="button" class="btn btn-success mt-3" id="copyPasswordBtn" style="display:none;">Copy</button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="confirmEmail">Confirm</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" id="closeModalBtn">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#revealPasswordBtn').click(function () {
            $('#passwordModal').modal('show');
        });

        $('#confirmEmail').click(function () {
            var emailInput = $('#emailInput').val();
            $.post('@Url.Action("RevealPassword")', { id: @Model.Id, emailInput: emailInput }, function (data) {
                if (data.success) {
                    $('#passwordReveal').html('<strong>Password: </strong>' + data.password);
                    $('#copyPasswordBtn').show();
                } else {
                    $('#passwordModal').modal('hide');
                    alert("Access denied!");
                }
            });
        });

        $('#copyPasswordBtn').click(function () {
            var passwordText = $('#passwordReveal').text().replace('Password: ', '').trim();
            navigator.clipboard.writeText(passwordText).then(function() {
                alert("Password copied to clipboard!");
            }, function(err) {
                console.error('Could not copy text: ', err);
            });
        });

        $('#closeModalBtn, .close').click(function () {
            $('#passwordModal').modal('hide');
        });
    </script>
}
