@model IPagedList<PasswordManager.Models.PasswordEntry>
@using X.PagedList
@using X.PagedList.Mvc.Core;

<div class="container mt-4">
    <h2>Password Entries</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <strong>Success!</strong> @TempData["Success"]
        </div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Create New Password
        </a>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Site</th>
                <th>Password For</th>
                <th>Email Address</th>
                <th>Password</th>
                <th>Created Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Site</td>
                    <td>@item.PasswordFor</td>
                    <td>@($"{item.EmailAddress[0]}****@****.com")</td>
                    <td>**********</td>
                    <td>@item.CreatedDate.ToLongDateString()</td>
                    <td>
                        <a class="btn btn-info" href="@Url.Action("Details", new { id = item.Id })">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    
    <div class="pagination-container">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
    </div>
</div>